PORT=3000
NODE_ENV=development

# Option A — Railway / hosted Postgres (single connection string, takes priority)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Option B — individual vars for local dev (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bhakti_bougie_travel
DB_USER=postgres
DB_PASSWORD=your_password_here
# Set DB_SSL=false to disable SSL for local Postgres
DB_SSL=false
